# ======================================
# UNAMBA Market - Configuración del Proyecto (EJEMPLO)
# ======================================
# 
# Copia este archivo como .env y actualiza los valores con tu configuración
# cp .env.example .env
#

# ======================================
# BACKEND - Java Spring Boot
# ======================================

# Configuración Base de Datos
DB_URL=jdbc:mariadb://localhost:3306/dbmarketunamba
DB_USERNAME=root
DB_PASSWORD=cambiaEstePassword
DB_DRIVER=org.mariadb.jdbc.Driver

# Configuración de Servidor
SERVER_PORT=8080
SERVER_SERVLET_CONTEXT_PATH=/

# Configuración de Aplicación
APP_NAME=backend
APP_PROFILE=dev

# Configuración JWT (Seguridad)
# IMPORTANTE: Genera tu propia secret key segura en Base64
# Puedes generar una con: echo -n "tu_texto_largo_y_secreto" | base64
JWT_SECRET_KEY=GENERA_UNA_SECRET_KEY_SEGURA_EN_BASE64_MINIMO_256_BITS
JWT_EXPIRATION_MS=1440000

# Configuración de Archivos
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=20MB

# Configuración de Hibernate/JPA
JPA_HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# ======================================
# FRONTEND - Angular
# ======================================

# Puerto de desarrollo Frontend
NG_PORT=4200

# URL del Backend
API_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080/api
UPLOAD_URL=http://localhost:8080/uploads

# Entorno
ENVIRONMENT=dev
PRODUCTION=false

# ======================================
# DATABASE - MariaDB (Opcional si usas Docker)
# ======================================

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=dbmarketunamba
MYSQL_USER=unamba_user
MYSQL_PASSWORD=unamba_password
